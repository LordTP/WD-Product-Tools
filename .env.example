# Copy to .env.local and fill in. .env.local is gitignored.

# Local SQLite path. In Docker this is set to /data/data.db (mounted volume).
DATABASE_PATH=data.db

# Where Drizzle migrations live (boot-time self-init). Default works locally.
# MIGRATIONS_DIR=drizzle

# --- ShipHero direct integration (Phase 2+) ---
# Required: long-lived refresh token (mints access tokens automatically).
SHIPHERO_REFRESH_TOKEN=
# Optional: paste the access token to use immediately until it expires (~28d).
SHIPHERO_ACCESS_TOKEN=
# Optional: required only to CREATE POs via the API (not for reads/sync).
SHIPHERO_WAREHOUSE_ID=
