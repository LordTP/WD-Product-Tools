# Copy to .env.local and fill in. .env.local is gitignored.

# App login — the single shared team password. When set, the whole app sits behind
# /login. REQUIRED in production. Leave blank locally to disable the gate.
APP_PASSWORD=

# Local SQLite path. In Docker this is set to /data/data.db (mounted volume).
DATABASE_PATH=data.db

# Where Drizzle migrations live (boot-time self-init). Default works locally.
# MIGRATIONS_DIR=drizzle

# --- ShipHero direct integration (Phase 2+) ---
# Required: long-lived refresh token (mints access tokens automatically).
SHIPHERO_REFRESH_TOKEN=
# Optional: paste the access token to use immediately until it expires (~28d).
SHIPHERO_ACCESS_TOKEN=
# Optional: required only to CREATE POs via the API (not for reads/sync).
SHIPHERO_WAREHOUSE_ID=

# Barcode Label Press (/barcodes):
# REQUIRED in production — the warehouse's own shared password for the label page.
BARCODES_PASSWORD=
# Optional — the published sheet link ships as a code default; set to override.
# BARCODES_SHEET_CSV_URL=

# Background sync scheduler (production only). Keeps every cache fresh without
# pressing Sync; buttons stay as manual overrides. Set "off" to disable, or
# "on" to force-enable in local dev (burns real ShipHero credits).
# SYNC_SCHEDULER=off
